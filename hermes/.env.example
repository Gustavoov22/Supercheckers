API_SERVER_KEY=<generate: openssl rand -base64 48 | tr -dc 'a-zA-Z0-9_-' | head -c 64>
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8642

# Disable browser-use extension downloads (required when extension CDNs are blocked)
BROWSERUSE_DISABLE_EXTENSIONS=1

# Path to Chromium binary for browser-use
CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# ── LLM backend (priority: MiniMax > Gemini > Claude > bash) ─────────────────

# 1. MiniMax (primary) — get key at minimaxi.chat
MINIMAX_API_KEY=sk-cp-...
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1

# 2. Google Gemini fallback (free tier at aistudio.google.com)
# GOOGLE_API_KEY=AIza...

# 3. Anthropic Claude fallback
# ANTHROPIC_API_KEY=sk-ant-...
